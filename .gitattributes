* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# vCards use CRLF line endings by spec; keep the live file byte for byte, and
# don't report those line endings as trailing whitespace.
*.vcf -text -whitespace

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
