# Production (and staging) environment for Copper Eagle Plumbing in Dokploy.
#
# Paste these into the app's Environment tab in Dokploy and fill in the blanks.
# Staging on coppereagle.growthboundmarketing.com uses this same file: keep the
# www values below and attach only the staging domain (docs/deployment/dokploy.md).
# Never commit real secrets here; this file holds placeholders and public IDs only.

# --- Required: the app will not start without these ---------------------------

# Generate once with: php artisan key:generate --show
APP_KEY=base64:replace-with-a-generated-key
APP_URL=https://www.coppereagleplumbing.com
# The one host search engines may index. Must match the host in APP_URL.
SITE_CANONICAL_HOST=www.coppereagleplumbing.com
APP_TIMEZONE=America/Denver

# Outgoing mail (lead notifications). Amazon SES SMTP credentials.
MAIL_MAILER=smtp
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-ses-smtp-username
MAIL_PASSWORD=replace-with-ses-smtp-password
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=replace-with-a-verified-sender@your-sending-domain
MAIL_FROM_NAME="Copper Eagle Plumbing"

# --- Dokploy Application deploys only --------------------------------------------
# The Application type runs one container, so it also needs the settings the
# compose file would otherwise set, and it has to run the scheduler itself.
# Leave these out of a Compose deploy (its scheduler service runs the schedule).
RUN_SCHEDULER=true
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
APP_NAME="Copper Eagle Plumbing"
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_LEVEL=info

# --- Leads ---------------------------------------------------------------------

# Who is emailed about each new lead (comma separated). A list saved later in
# Admin → Notifications takes over from this.
LEAD_NOTIFICATION_RECIPIENTS=diamond9utah@gmail.com

# The contact form posts to the site itself ("native"); HighLevel delivery is
# connected in Admin → HighLevel with a private integration token and
# location ID. Set "highlevel" only to embed a HighLevel-hosted form instead.
WEBSITE_FORM_PROVIDER=native
WEBSITE_HIGHLEVEL_ORIGIN=https://api.leadconnectorhq.com
WEBSITE_HIGHLEVEL_INQUIRY_FORM_ID=
WEBSITE_HIGHLEVEL_FEEDBACK_FORM_ID=
WEBSITE_HIGHLEVEL_COMMENTS_FORM_ID=

# --- Tracking ------------------------------------------------------------------
# Copied from the live Squarespace site so reporting continues after launch.
# Values saved in Admin → Tracking take over from these.

# Google Tag Manager container on the live site. It already loads GA4
# (G-DKLZCME1Q9), so leave TRACKING_GA4_MEASUREMENT_ID blank or every visit is
# counted twice.
TRACKING_GTM_CONTAINER_ID=GTM-TPNKWP37
TRACKING_GA4_MEASUREMENT_ID=
# CallTrackingMetrics account on the live site (581672.tctm.co). It swaps the
# phone number shown to each visitor for a tracking number.
TRACKING_CTM_ACCOUNT_ID=581672
TRACKING_CLARITY_PROJECT_ID=
TRACKING_META_PIXEL_ID=
# Load tracking only on SITE_CANONICAL_HOST, so staging visits stay out of the
# client's analytics and call tracking. Set false only to test tags on staging.
TRACKING_CANONICAL_HOST_ONLY=true

# --- Referral program (optional; leave blank if unused) --------------------------

REFERRAL_FORM_URL=
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
GHL_COMPANY_ID=
GHL_EXCLUDED_USER_IDS=
GHL_REFERRAL_CODE_FIELD_ID=
GHL_REFERRAL_SOURCE_FIELD_ID=
GHL_REFERRAL_BUSINESS_FIELD_ID=
GHL_REFERRAL_MAIN_CONTACT_FIELD_ID=
GHL_REFERRAL_URL_FIELD_ID=
GHL_REFERRAL_SERVICE_AREAS_FIELD_ID=
