APP_NAME="Copper Eagle"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8012

# The single hostname allowed into search indexes. Every other host serving this
# app — staging, preview deploys, raw IPs — returns noindex and Disallow: /.
# Bare hostname only — no scheme, no path, no port — because Caddy compares it
# literally when it serves static files, and because nothing it is checked
# against carries a port. Anything else is refused, and a refused value indexes
# nothing. Must match the host in APP_URL or boot fails. Leave unset anywhere
# that is not the real public site. Production must set it,
# or production will not be indexed.
SITE_CANONICAL_HOST=
APP_TIMEZONE=UTC

MEDIA_IMPORT_API_URL=
MEDIA_IMPORT_API_USER=
MEDIA_IMPORT_API_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Homeowner form that referral links open. Must be an absolute HTTPS URL.
REFERRAL_FORM_URL=
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
# Optional agency ID enables the paginated /users/search API.
GHL_COMPANY_ID=
# Optional comma-separated HighLevel user IDs to hide. Empty includes everyone.
GHL_EXCLUDED_USER_IDS=
# Optional Contact field ID overrides. When missing, IDs are discovered from this location by field key.
GHL_REFERRAL_CODE_FIELD_ID=
GHL_REFERRAL_SOURCE_FIELD_ID=
GHL_REFERRAL_BUSINESS_FIELD_ID=
GHL_REFERRAL_MAIN_CONTACT_FIELD_ID=
GHL_REFERRAL_URL_FIELD_ID=
# Optional Contact multi-select field ID; otherwise discovered and choice-validated.
GHL_REFERRAL_SERVICE_AREAS_FIELD_ID=

# Where /media/{id} references resolve. Empty serves media from this install.
# Point it at another install to render that library without editing content.
MEDIA_BASE_URL=

# Website intake is independent of the referral account above.
# Activate HighLevel only after the website-account cutover checklist is complete.
WEBSITE_FORM_PROVIDER=native
WEBSITE_HIGHLEVEL_ORIGIN=https://api.leadconnectorhq.com
WEBSITE_HIGHLEVEL_INQUIRY_FORM_ID=
# Dedicated destinations only; blanks display a contact alternative.
WEBSITE_HIGHLEVEL_FEEDBACK_FORM_ID=
WEBSITE_HIGHLEVEL_COMMENTS_FORM_ID=
